// storyboard.dot
// muxterm — workspace chrome mockup storyboard
// Tokyo Night dark theme  ·  engine: dot  ·  rankdir: LR
// Canonical reference for the 5-page chrome mockup (this round's scope):
//   workspace switcher moves to the bottom-left status bar; the tab bar
//   holds only terminal tabs; the top-right "⋯" is app-level only.

digraph muxterm_storyboard {

    // ── Graph defaults ───────────────────────────────────────────────
    graph [
        label       = "muxterm — workspace chrome (5-page mockup)\nswitcher → bottom-left status bar  ·  tab bar = terminal tabs only  ·  ⋯ = app-level"
        labelloc    = t
        fontname    = "Helvetica,Arial,sans-serif"
        fontsize    = 16
        fontcolor   = "#c0caf5"
        bgcolor     = "#1a1b26"
        rankdir     = LR
        pad         = "0.6,0.5"
        splines     = spline
        nodesep     = 0.7
        ranksep     = 1.1
    ]

    node [
        fontname    = "Helvetica,Arial,sans-serif"
        fontsize    = 12
        fontcolor   = "#c0caf5"
        shape       = box
        style       = "filled,rounded"
        fillcolor   = "#1f2335"
        color       = "#3b4261"
        penwidth    = 1.5
        margin      = "0.24,0.16"
    ]

    edge [
        fontname    = "Helvetica,Arial,sans-serif"
        fontsize    = 10
        fontcolor   = "#7dcfff"
        color       = "#7aa2f7"
        penwidth    = 1.5
        arrowsize   = 0.85
    ]

    // ── Pages ────────────────────────────────────────────────────────
    base [
        label = <<B>1 · base</B><BR/>
                  <FONT POINT-SIZE="10" COLOR="#a9b1d6">chrome at rest (wide)  ·  terminal tabs<BR/>switcher ● work ⌄ bottom-left</FONT>>
    ]

    workspaces [
        label = <<B>2 · workspaces</B><BR/>
                  <FONT POINT-SIZE="10" COLOR="#a9b1d6">switcher dropdown opens upward<BR/>✓ work · agents · ＋ New workspace…</FONT>>
    ]

    appmenu [
        label = <<B>3 · app-menu</B><BR/>
                  <FONT POINT-SIZE="10" COLOR="#a9b1d6">top-right ⋯ open · app-level only<BR/>Settings · Shortcuts · Reconnect · About</FONT>>
    ]

    tabs [
        label = <<B>4 · tabs</B><BR/>
                  <FONT POINT-SIZE="10" COLOR="#a9b1d6">tab-bar detail · editor/shell/logs/build<BR/>dirty dot · close · ＋</FONT>>
    ]

    responsive [
        label     = <<B><FONT COLOR="#7dcfff">5 · responsive</FONT></B><BR/>
                      <FONT POINT-SIZE="10" COLOR="#89d9f0">narrow / phone (~390px)<BR/>tabs collapse · switcher condensed</FONT>>
        fillcolor = "#192535"
        color     = "#7dcfff"
        penwidth  = 2.0
    ]

    // ── Flow ─────────────────────────────────────────────────────────
    base       -> workspaces [ label = "click switcher" ]
    workspaces -> appmenu    [ label = "open ⋯ menu" ]
    appmenu    -> tabs       [ label = "manage tabs" ]
    tabs       -> responsive [ label = "narrow width" ]
}
