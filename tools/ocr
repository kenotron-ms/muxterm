#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pillow"]
# ///
"""
Terminal OCR — read text content from a muxterm screenshot.

Usage:
    tools/ocr                          # screenshot muxterm in Chrome + OCR
    tools/ocr /path/to/snap.png        # OCR a pre-taken screenshot
    tools/ocr --region x,y,w,h        # restrict OCR to a pixel region (CSS px)
    tools/ocr --url http://...         # navigate to URL first
    tools/ocr --raw                    # skip preprocessing (dark→light invert)
    tools/ocr --psm N                  # tesseract page-seg mode (default: 6)

Output:
    Recognized text to stdout. Diagnostic info to stderr.

Requires:
    tesseract   (brew install tesseract)
    magick      (brew install imagemagick)
    playwright-cli installed and PLAYWRIGHT_MCP_EXTENSION_TOKEN set

Works with canvas-based terminals (xterm.js, ghostty-web) — DOM contains
no readable text nodes, so screenshot + OCR is the only inspection path.
"""

import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path


# ── Config ────────────────────────────────────────────────────────────────────

TOKEN = os.environ.get(
    "PLAYWRIGHT_MCP_EXTENSION_TOKEN",
    "RxVEkS44RBK8MxV2ONSC-yn0PEwtIhBIX3gOyn7wpdE",
)
DEFAULT_URL = "http://localhost:8080"
SCALE = "300%"  # scale before OCR — terminal fonts are ~12px, tesseract wants ≥20px


# ── Helpers ───────────────────────────────────────────────────────────────────

def die(msg: str) -> None:
    print(f"ocr: {msg}", file=sys.stderr)
    sys.exit(1)


def check_deps() -> None:
    for cmd in ("tesseract", "magick", "playwright-cli"):
        if subprocess.run(["which", cmd], capture_output=True).returncode != 0:
            die(f"'{cmd}' not found — run: brew install {'imagemagick' if cmd == 'magick' else cmd}")


def pw(*args: str) -> str:
    """Run a playwright-cli command against the attached Chrome session.
    Returns stdout; silences stderr except on failure."""
    env = {**os.environ, "PLAYWRIGHT_MCP_EXTENSION_TOKEN": TOKEN}
    cmd = f"playwright-cli -s=chrome {' '.join(args)}"
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True, env=env)
    return r.stdout


def attach() -> None:
    env = {**os.environ, "PLAYWRIGHT_MCP_EXTENSION_TOKEN": TOKEN}
    subprocess.run(
        f"playwright-cli -s=chrome attach --extension=chrome",
        shell=True, capture_output=True, env=env,
    )


def navigate(url: str) -> None:
    print(f"ocr: navigating to {url}", file=sys.stderr)
    pw(f"goto {url}")


def screenshot(path: str) -> None:
    out = pw(f"screenshot --filename={path}")
    if not Path(path).exists() or Path(path).stat().st_size < 500:
        die(f"screenshot failed (output: {out.strip()!r})")
    print(f"ocr: screenshot {Path(path).stat().st_size} bytes", file=sys.stderr)


def terminal_bounds() -> tuple[int, int, int, int] | None:
    """Return CSS bounding box of the terminal area (mux-layout element)."""
    js = (
        "(function(){"
        "var a=document.querySelector('mux-app');"
        "if(!a||!a.shadowRoot)return 'null';"
        "var l=a.shadowRoot.querySelector('mux-layout');"
        "if(!l)return 'null';"
        "var r=l.getBoundingClientRect();"
        "return Math.round(r.x)+','+Math.round(r.y)+','+"
        "Math.round(r.width)+','+Math.round(r.height);"
        "})()"
    )
    out = pw(f'eval "{js}"')
    m = re.search(r'"(\d+),(\d+),(\d+),(\d+)"', out)
    if m:
        return int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4))
    return None


def is_retina(path: str) -> bool:
    out = subprocess.run(
        ["magick", path, "-format", "%w", "info:"],
        capture_output=True, text=True,
    ).stdout.strip()
    try:
        # @2x retina: a ~1400px viewport-width screenshot means physical width ~2800px
        return int(out) > 1400
    except ValueError:
        return False


def mean_brightness(path: str) -> float:
    out = subprocess.run(
        ["magick", path, "-format", "%[fx:mean]", "info:"],
        capture_output=True, text=True,
    ).stdout.strip()
    try:
        return float(out)
    except ValueError:
        return 0.5


def preprocess(src: str, dst: str, region: tuple | None, raw: bool) -> None:
    ops = []

    # Crop to terminal area
    if region:
        x, y, w, h = region
        mul = 2 if is_retina(src) else 1
        ops += ["-crop", f"{w*mul}x{h*mul}+{x*mul}+{y*mul}", "+repage"]

    if raw:
        cmd = ["magick", src] + ops + [dst]
        subprocess.run(cmd, capture_output=True, check=True)
        return

    # Detect theme: terminals are dark bg + light text → invert for tesseract
    with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as f:
        probe = f.name
    subprocess.run(["magick", src] + (ops or []) + [probe], capture_output=True)
    brightness = mean_brightness(probe)
    Path(probe).unlink(missing_ok=True)
    print(f"ocr: mean brightness={brightness:.3f} ({'dark→invert' if brightness < 0.5 else 'light'})", file=sys.stderr)

    if brightness < 0.5:
        ops += ["-negate"]

    ops += [
        "-resize", SCALE,
        "-unsharp", "0x1",
        "-contrast-stretch", "2%x2%",
    ]

    r = subprocess.run(["magick", src] + ops + [dst], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"magick error: {r.stderr.strip()}")


def ocr(src: str, psm: str) -> str:
    with tempfile.NamedTemporaryFile(suffix=".txt", delete=False) as f:
        base = f.name.replace(".txt", "")
    subprocess.run(
        ["tesseract", src, base, "--psm", psm, "--oem", "1",
         "-c", "preserve_interword_spaces=1"],
        capture_output=True,
    )
    txt = base + ".txt"
    text = Path(txt).read_text(errors="replace") if Path(txt).exists() else ""
    Path(txt).unlink(missing_ok=True)
    return "\n".join(l.rstrip() for l in text.splitlines()).strip()


# ── Main ──────────────────────────────────────────────────────────────────────

def main() -> None:
    check_deps()

    args = sys.argv[1:]

    raw = "--raw" in args
    if raw:
        args.remove("--raw")

    psm = "6"
    if "--psm" in args:
        i = args.index("--psm")
        psm = args[i + 1]
        args = args[:i] + args[i + 2:]

    url = None
    if "--url" in args:
        i = args.index("--url")
        url = args[i + 1]
        args = args[:i] + args[i + 2:]

    region: tuple | None = None
    if "--region" in args:
        i = args.index("--region")
        region = tuple(int(p) for p in args[i + 1].split(","))
        args = args[:i] + args[i + 2:]

    with tempfile.TemporaryDirectory() as tmp:
        snap = os.path.join(tmp, "snap.png")
        prep = os.path.join(tmp, "prep.png")

        if args and Path(args[0]).exists():
            snap = args[0]
            print(f"ocr: using file {snap}", file=sys.stderr)
        else:
            print("ocr: attaching to Chrome...", file=sys.stderr)
            attach()
            if url:
                navigate(url)
                import time; time.sleep(1)  # let page settle
            else:
                # ensure we're on muxterm, not the extension page
                current = pw("eval \"location.href\"")
                if "localhost:8080" not in current:
                    navigate(DEFAULT_URL)
                    import time; time.sleep(1)
            screenshot(snap)

            if region is None:
                bounds = terminal_bounds()
                if bounds:
                    print(f"ocr: terminal bounds: {bounds}", file=sys.stderr)
                    region = bounds
                else:
                    print("ocr: terminal element not found, using full viewport", file=sys.stderr)

        preprocess(snap, prep, region=region, raw=raw)
        text = ocr(prep, psm)
        print(text)


if __name__ == "__main__":
    main()
