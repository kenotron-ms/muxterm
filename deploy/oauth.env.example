# oauth2-proxy config for muxterm.ampbox.io
# ---------------------------------------------------------------------------
# Install this (filled in) at:  ~/.config/amplifier-muxterm/oauth.env   (chmod 600)
# It is read by the amplifier-muxterm-oauth.service systemd unit.
# NEVER commit the filled-in version — only this .example belongs in git.
#
# A GitHub-OAuth gate in front of an app that has NO real auth of its own.
# muxterm trusts loopback, so the ONLY thing keeping a shell on this machine
# private is this gate. Do not point Caddy straight at muxterm (:9090) —
# always go through oauth2-proxy.
#
# REUSES THE WIKI'S GITHUB OAUTH APP (no new app needed).
# A GitHub OAuth App registers a single callback URL, so to cover a second
# subdomain we share the oauth2-proxy session cookie across *.ampbox.io:
#   - same CLIENT_ID / CLIENT_SECRET / COOKIE_SECRET as ~/.config/amplifier-wiki/oauth.env
#   - REDIRECT_URL stays the wiki's (the registered callback)
#   - COOKIE_DOMAINS / WHITELIST_DOMAINS = .ampbox.io   (on BOTH gates)
# The wiki's callback issues a cookie on .ampbox.io, then bounces back here.
# (The wiki's oauth.env must ALSO set the two .ampbox.io lines — see README.)
#
# To use a *separate* GitHub OAuth App instead, create one with callback
# https://muxterm.ampbox.io/oauth2/callback, drop the COOKIE_DOMAINS/
# WHITELIST_DOMAINS lines, and set REDIRECT_URL to muxterm's own callback.
# ---------------------------------------------------------------------------

OAUTH2_PROXY_PROVIDER=github

# Reuse the wiki OAuth App's Client ID/Secret (copy from amplifier-wiki/oauth.env):
OAUTH2_PROXY_CLIENT_ID=REPLACE_WITH_WIKI_CLIENT_ID
OAUTH2_PROXY_CLIENT_SECRET=REPLACE_WITH_WIKI_CLIENT_SECRET

# Allowlist — ONLY this GitHub username can log in. This is what keeps muxterm
# private to you. (comma-separate if you ever want more.)
OAUTH2_PROXY_GITHUB_USER=kenotron-ms

# github provider authenticates by the username allowlist above; allow any email.
OAUTH2_PROXY_EMAIL_DOMAINS=*

# MUST equal the wiki's cookie secret so the shared .ampbox.io cookie the wiki
# callback issues can be decrypted here. (copy from amplifier-wiki/oauth.env)
OAUTH2_PROXY_COOKIE_SECRET=REPLACE_WITH_WIKI_COOKIE_SECRET

# Canonical callback = the wiki's (the one registered on the shared OAuth App).
OAUTH2_PROXY_REDIRECT_URL=https://wiki.ampbox.io/oauth2/callback

# Share session + CSRF cookies across every *.ampbox.io host and allow the
# post-login redirect back to this subdomain. Must also be set on the wiki gate.
OAUTH2_PROXY_COOKIE_DOMAINS=.ampbox.io
OAUTH2_PROXY_WHITELIST_DOMAINS=.ampbox.io

# Gate listens on the bridge IP (the host Caddy lives in a different netns and
# reaches same-host services via 10.66.204.209, NOT 127.0.0.1) and proxies
# authorized traffic to muxterm's loopback-only serve port (:9090).
# NOTE: 4180 is taken by the wiki's oauth2-proxy — muxterm uses 4181.
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4181
OAUTH2_PROXY_UPSTREAMS=http://127.0.0.1:9090
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_COOKIE_SECURE=true

# muxterm is a WebSocket app (tmux control-mode relay on /ws). oauth2-proxy
# proxies websockets by default; this is explicit for clarity.
OAUTH2_PROXY_PROXY_WEBSOCKETS=true
