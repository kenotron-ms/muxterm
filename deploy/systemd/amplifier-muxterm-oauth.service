[Unit]
Description=oauth2-proxy — GitHub OAuth gate for muxterm.ampbox.io (private to Ken)
After=network-online.target amplifier-muxterm-serve.service
Wants=network-online.target

[Service]
Type=simple
# Secrets (GitHub client id/secret, cookie secret) live ONLY in this 0600 file,
# never in the repo.
EnvironmentFile=%h/.config/amplifier-muxterm/oauth.env
ExecStart=%h/go/bin/oauth2-proxy
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
