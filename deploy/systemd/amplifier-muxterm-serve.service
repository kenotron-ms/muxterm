[Unit]
Description=muxterm — terminal multiplexer web server (LOCALHOST only; gated by oauth2-proxy)
Documentation=https://muxterm.ampbox.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Bind to LOOPBACK only. muxterm trusts loopback and has no auth of its own, so
# it must never be reachable except through the oauth2-proxy gate
# (amplifier-muxterm-oauth.service). Public exposure happens at the Caddy layer.
ExecStart=/home/ken/workspace/muxterm/bin/muxterm serve --addr 127.0.0.1:9090
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
