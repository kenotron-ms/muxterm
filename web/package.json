{
  "name": "muxterm-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "typecheck:fast": "npx @typescript/native-preview --noEmit",
    "lint:fast": "oxlint src",
    "check:fast": "npm run typecheck:fast && npm run lint:fast",
    "test:file": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-fonts": "^0.1.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-core": "^6.6.1",
    "lit": "^3.2.0",
    "lucide": "^1.17.0",
    "split.js": "^1.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@typescript/native-preview": "^7.0.0-dev.20260609.1",
    "eslint": "^10.4.1",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.68.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
