<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+. Declaring the type-specific permissions is what stops
         startForeground() throwing SecurityException on Android 14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- API 33+ runtime permission. The foreground service runs without it;
         only the notification is suppressed. Voice is never gated on it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Deliberately NOT declared (design doc W1.2/W1.4):
           REQUEST_IGNORE_BATTERY_OPTIMIZATIONS - would help against vendor
             battery managers, needs a reviewable justification. Add it when a
             real device shows it is needed.
           WAKE_LOCK - the foreground service is what keeps the process alive;
             a partial wake lock on top is cargo cult until proven otherwise.
           CAMERA / READ_MEDIA_* - not until attachments are actually built. -->

    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Muxterm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- foregroundServiceType MUST list every type ever passed to
             startForeground(). Passing an undeclared type throws
             IllegalArgumentException; omitting the attribute entirely throws
             MissingForegroundServiceTypeException on Android 14+. -->
        <service
            android:name=".VoiceSessionService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

    </application>
</manifest>
